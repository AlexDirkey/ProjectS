{
  "$schema": "https://raw.githubusercontent.com/RicoSuter/NSwag/master/src/NSwag.Commands/commands/nswagjsonschema.json",
  "runtime": "Net90",
  "documentGenerator": {
    "fromDocument": {
      "url": "http://localhost:5080/swagger/v1/swagger.json"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "ApiClient",
      "template": "Fetch",
      "useAbortSignal": true,
      "generateClientClasses": true,
      "generateClientInterfaces": true,
      "generateOptionalParameters": true,
      "nullValue": "Undefined",
      "wrapDtoExceptions": false,
      "output": "../client/src/api/backend.ts"
    }
  }
}